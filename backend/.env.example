# Django backend. Copy to .env and fill in.
DJANGO_SECRET_KEY=generate-a-50-char-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,.vercel.app
# Neon Postgres connection string (pooled).
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
# Shared secret. MUST match the gateway's GATEWAY_KEY.
GATEWAY_KEY=generate-a-32-byte-random-string
# Only the gateway should be allowed cross-origin.
CORS_ALLOWED_ORIGINS=http://localhost:4000
