# Node gateway. Copy to .env and fill in.
NODE_ENV=development
PORT=4000
# Where Django is reachable. Never exposed to the browser.
BACKEND_URL=http://127.0.0.1:8000
# Shared secret. MUST match the backend's GATEWAY_KEY.
GATEWAY_KEY=generate-a-32-byte-random-string
SESSION_COOKIE_NAME=kg_session
# The frontend origin allowed to send credentialed requests.
ALLOWED_ORIGIN=http://localhost:3000
